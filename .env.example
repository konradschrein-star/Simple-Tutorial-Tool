# ───────────────────────── Required ─────────────────────────
# PostgreSQL + Redis. The docker-compose.yml in this repo starts both with
# these exact values, so you can leave them as-is for local use.
DATABASE_URL=postgresql://tutorial:tutorial@localhost:5432/tutorial
REDIS_URL=redis://localhost:6379

# Session signing secret — any random string of 32+ chars.
#   generate:  openssl rand -base64 48
JWT_SECRET=

# Encryption key for the provider API keys you enter in the app's Settings.
# Must decode to exactly 32 bytes.
#   generate:  openssl rand -base64 32
SECRETS_ENCRYPTION_KEY=

# Absolute path for recordings + rendered videos. The web app and the worker
# BOTH read/write here, so it must be the same absolute path for both.
LOCAL_MEDIA_ROOT=/absolute/path/to/tutorial-media

# ─────────────── Admin account (used once by `pnpm setup:admin`) ───────────────
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-this-password
ADMIN_NAME=Admin

# ───────────────────────── Optional ─────────────────────────
# Built-in script generator (the default "Gemini Pool" provider) calls Claude.
# Every other LLM/TTS provider (AI33, ElevenLabs, Minimax, Google, OpenAI…) is
# configured inside the app under Settings, not here.
ANTHROPIC_API_KEY=

# ffmpeg binary — defaults to "ffmpeg" on your PATH.
FFMPEG_PATH=ffmpeg

# Server bind + origins
PORT=3000
BIND_HOST=0.0.0.0
ALLOWED_ORIGINS=localhost:3000

# Public base URL — only needed if you enable Google Drive auto-upload.
PUBLIC_URL=http://localhost:3000
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
