{
  "name": "@repo/db",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./schema": { "types": "./dist/schema/index.d.ts", "default": "./dist/schema/index.js" },
    "./repositories": { "types": "./dist/repositories/index.d.ts", "default": "./dist/repositories/index.js" },
    "./singleton": { "types": "./dist/singleton.d.ts", "default": "./dist/singleton.js" }
  },
  "scripts": {
    "build": "tsc --build",
    "dev": "tsc --build --watch",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "drizzle-orm": "^0.36.4",
    "pg": "^8.20.0",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "drizzle-kit": "^0.30.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
